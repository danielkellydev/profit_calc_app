<div class="container mx-auto px-4 py-6">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Custom periods</h1>
    <%= link_to 'New custom period', new_custom_period_path,
          class: 'bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2 px-4 rounded' %>
  </div>

  <% if @custom_periods.any? %>
    <div class="bg-white shadow-md rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50 text-xs text-gray-500 uppercase">
          <tr>
            <th class="px-4 py-2 text-left">Name</th>
            <th class="px-4 py-2 text-left">Start</th>
            <th class="px-4 py-2 text-left">End</th>
            <th class="px-4 py-2 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-100">
          <% @custom_periods.each do |period| %>
            <tr>
              <td class="px-4 py-2 font-medium text-gray-900">
                <%= link_to period.name, custom_period_path(period), class: 'text-blue-600 hover:text-blue-900' %>
              </td>
              <td class="px-4 py-2"><%= period.start_date&.strftime('%-d %b %Y') %></td>
              <td class="px-4 py-2"><%= period.end_date&.strftime('%-d %b %Y') %></td>
              <td class="px-4 py-2 text-right">
                <%= button_to 'Delete', custom_period_path(period), method: :delete,
                      form: { data: { turbo_confirm: 'Delete this custom period?' } },
                      class: 'text-red-600 hover:text-red-900 bg-transparent p-0 border-0 cursor-pointer inline' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-white shadow-md rounded-lg p-8 text-center text-gray-500">
      No custom periods yet.
    </div>
  <% end %>
</div>

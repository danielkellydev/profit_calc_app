<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
  <div class="text-center">
    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-lime-100 text-lime-900 text-xs font-medium tracking-wide uppercase">
      Books for sole traders
    </span>
    <h1 class="mt-6 font-display text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-zinc-900">
      Tax time, <span class="text-zinc-400">without the panic.</span>
    </h1>
    <p class="mt-5 max-w-xl mx-auto text-base sm:text-lg text-zinc-600">
      Log one-off purchases as they happen, sync your WooCommerce revenue,
      and see your net taxable profit at a glance.
    </p>

    <div class="mt-8 flex flex-col sm:flex-row sm:justify-center gap-3">
      <% if user_signed_in? %>
        <%= link_to "Go to dashboard", dashboard_index_path,
              class: "inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-zinc-900 hover:bg-zinc-800 text-white text-sm font-semibold transition" %>
        <%= link_to "Log an expense", expenses_path,
              class: "inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-white hover:bg-zinc-50 border border-zinc-300 text-zinc-900 text-sm font-semibold transition" %>
      <% else %>
        <%= link_to "Create an account", new_user_registration_path,
              class: "inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-zinc-900 hover:bg-zinc-800 text-white text-sm font-semibold transition" %>
        <%= link_to "Log in", new_user_session_path,
              class: "inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-white hover:bg-zinc-50 border border-zinc-300 text-zinc-900 text-sm font-semibold transition" %>
      <% end %>
    </div>
  </div>
</div>

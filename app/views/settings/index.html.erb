<div class="space-y-6">
  <h1 class="font-display text-2xl sm:text-3xl font-bold text-zinc-900 tracking-tight">Settings</h1>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <%= link_to expense_categories_path, class: "block group" do %>
      <div class="bg-white rounded-xl ring-1 ring-zinc-200 group-hover:ring-zinc-300 transition p-5 h-full">
        <h3 class="font-display text-lg font-semibold text-zinc-900">Expense categories</h3>
        <p class="mt-1 text-sm text-zinc-500">
          Manage categories and their default business-use percentage.
        </p>
        <p class="mt-3 text-xs text-zinc-700 font-medium">Open →</p>
      </div>
    <% end %>

    <%= render "woocommerce_configs/card" %>
  </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <h1 class="text-2xl font-semibold text-gray-900 mb-6">Settings</h1>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <%= link_to expense_categories_path, class: "block" do %>
      <div class="bg-white overflow-hidden shadow rounded-lg hover:shadow-md transition-shadow">
        <div class="px-4 py-5 sm:p-6">
          <h3 class="text-lg leading-6 font-medium text-gray-900">Expense Categories</h3>
          <p class="mt-1 text-sm text-gray-500">
            Manage categories and their default business-use percentage.
          </p>
        </div>
      </div>
    <% end %>

    <%= render "woocommerce_configs/card" %>
  </div>
</div>

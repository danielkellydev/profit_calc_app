<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
    <div>
      <h1 class="font-display text-2xl sm:text-3xl font-bold text-zinc-900 tracking-tight"><%= FinancialYear.label(@fy) %> Dashboard</h1>
      <p class="text-sm text-zinc-500">
        <%= @fy.first.strftime('%-d %b %Y') %> – <%= @fy.last.strftime('%-d %b %Y') %>
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <%= form_with url: dashboard_index_path, method: :get, local: true, class: 'flex items-center gap-2' do |f| %>
        <%= f.label :fy, 'FY', class: 'text-sm text-zinc-600' %>
        <%= f.select :fy, fy_options(@fy), {}, { class: 'rounded-lg border-zinc-300 text-sm focus:border-zinc-900 focus:ring-zinc-900', onchange: 'this.form.submit()' } %>
      <% end %>

      <% if @woocommerce_configured %>
        <%= button_to 'Refresh from Woo', refresh_woocommerce_dashboard_index_path(fy: FinancialYear.start_year(@fy)),
              method: :post,
              class: 'bg-zinc-900 hover:bg-zinc-800 text-white text-sm font-semibold py-2 px-3.5 rounded-lg' %>
      <% else %>
        <%= link_to 'Configure WooCommerce', edit_woocommerce_config_path,
              class: 'bg-zinc-900 hover:bg-zinc-800 text-white text-sm font-semibold py-2 px-3.5 rounded-lg' %>
      <% end %>

      <%= link_to "Export receipts", receipts_export_path(fy: FinancialYear.start_year(@fy)),
            class: 'bg-white border border-zinc-300 hover:bg-zinc-50 text-zinc-900 text-sm font-medium py-2 px-3.5 rounded-lg' %>
    </div>
  </div>

  <% if @snapshot.nil? && @woocommerce_configured %>
    <div class="bg-amber-50 border border-amber-200 text-amber-900 px-4 py-3 rounded-lg text-sm">
      No revenue data for this period yet. Click <span class="font-semibold">Refresh from Woo</span> to pull totals.
    </div>
  <% end %>

  <% if current_user.woocommerce_config&.last_sync_status.in?(%w[auth_error unreachable]) %>
    <div class="bg-rose-50 border border-rose-200 text-rose-900 px-4 py-3 rounded-lg text-sm">
      Last sync failed: <%= current_user.woocommerce_config.last_sync_error %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
    <%= render 'card', title: 'FY Revenue (Woo)',     value: number_to_currency(@revenue),         accent: 'positive' %>
    <%= render 'card', title: 'Total Expenses Paid',  value: number_to_currency(@total_paid),      accent: 'neutral' %>
    <%= render 'card', title: 'Claimable Expenses',   value: number_to_currency(@total_claimable), accent: 'accent' %>
    <%= render 'card', title: 'Net Taxable Profit',   value: number_to_currency(@net_profit),      accent: @net_profit.negative? ? 'negative' : 'positive' %>
  </div>

  <% if @snapshot %>
    <p class="text-xs text-zinc-500">
      Revenue last synced <%= time_ago_in_words(@snapshot.fetched_at) %> ago
      (<%= @snapshot.order_count %> orders, net <%= number_to_currency(@snapshot.net_sales) %>).
    </p>
  <% end %>

  <div class="bg-white rounded-xl ring-1 ring-zinc-200 p-4 sm:p-6">
    <h2 class="font-display text-lg font-semibold text-zinc-900 mb-4">Claimable expenses by category</h2>
    <% if @category_breakdown.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead class="text-zinc-500 text-xs uppercase tracking-wider">
            <tr>
              <th class="text-left py-2 font-medium">Category</th>
              <th class="text-right py-2 font-medium">FY total</th>
              <th class="text-right py-2 font-medium">% of total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100">
            <% @category_breakdown.each do |row| %>
              <tr>
                <td class="py-2.5 text-zinc-900"><%= row[:name] %></td>
                <td class="py-2.5 text-right tabular-nums text-zinc-900"><%= number_to_currency(row[:amount]) %></td>
                <td class="py-2.5 text-right tabular-nums text-zinc-500"><%= row[:percentage] %>%</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-zinc-500 text-sm">No expenses recorded for this period yet.</p>
    <% end %>
  </div>
</div>

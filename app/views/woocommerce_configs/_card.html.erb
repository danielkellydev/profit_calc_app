<div class="bg-white overflow-hidden shadow rounded-lg">
  <div class="px-4 py-5 sm:p-6">
    <h3 class="text-lg leading-6 font-medium text-gray-900">WooCommerce</h3>
    <% config = current_user.woocommerce_config %>
    <% if config&.configured? %>
      <p class="mt-1 text-sm text-green-600">Configured.</p>
      <% if config.last_synced_at %>
        <p class="mt-2 text-xs text-gray-500">
          Last sync: <%= time_ago_in_words(config.last_synced_at) %> ago
          <% if config.last_sync_status == 'ok' %>
            <span class="text-green-600">(ok)</span>
          <% elsif config.last_sync_status == 'auth_error' %>
            <span class="text-red-600">(auth failed)</span>
          <% elsif config.last_sync_status == 'unreachable' %>
            <span class="text-red-600">(unreachable)</span>
          <% end %>
        </p>
      <% end %>
    <% else %>
      <p class="mt-1 text-sm text-gray-500">Connect your WooCommerce store to pull revenue totals.</p>
    <% end %>
    <div class="mt-4">
      <%= link_to (config&.configured? ? "Edit" : "Configure"), edit_woocommerce_config_path,
            class: "w-full inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700" %>
    </div>
  </div>
</div>

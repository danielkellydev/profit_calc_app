<div class="bg-white rounded-xl ring-1 ring-zinc-200 p-5 flex flex-col">
  <h3 class="font-display text-lg font-semibold text-zinc-900">WooCommerce</h3>
  <% config = current_user.woocommerce_config %>
  <% if config&.configured? %>
    <p class="mt-1 text-sm text-emerald-700 font-medium">Configured</p>
    <% if config.last_synced_at %>
      <p class="mt-2 text-xs text-zinc-500">
        Last sync: <%= time_ago_in_words(config.last_synced_at) %> ago
        <% case config.last_sync_status %>
        <% when 'ok' %>
          <span class="text-emerald-700">· ok</span>
        <% when 'auth_error' %>
          <span class="text-rose-700">· auth failed</span>
        <% when 'unreachable' %>
          <span class="text-rose-700">· unreachable</span>
        <% end %>
      </p>
    <% end %>
  <% else %>
    <p class="mt-1 text-sm text-zinc-500">Connect your WooCommerce store to pull revenue totals.</p>
  <% end %>
  <div class="mt-auto pt-4">
    <%= link_to (config&.configured? ? "Edit connection" : "Configure"), edit_woocommerce_config_path,
          class: "w-full inline-flex justify-center py-2 px-4 text-sm font-semibold rounded-lg text-white bg-zinc-900 hover:bg-zinc-800 transition" %>
  </div>
</div>

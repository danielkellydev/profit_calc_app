<div class="max-w-2xl mx-auto">
  <div class="bg-white rounded-xl ring-1 ring-zinc-200 p-4 sm:p-6" data-controller="woo-test">
    <h1 class="font-display text-2xl font-bold text-zinc-900 mb-2">WooCommerce settings</h1>
    <p class="text-sm text-zinc-500 mb-6">
      Generate a read-only REST API key in your WooCommerce store under
      <em>Settings → Advanced → REST API</em>, then paste the consumer key and secret here.
    </p>

    <%= form_with model: @config, url: woocommerce_config_path, method: :patch, local: true, class: "space-y-4" do |form| %>
      <% if @config.errors.any? %>
        <div class="bg-rose-50 border border-rose-200 rounded-lg p-3">
          <p class="text-rose-900 text-sm font-semibold">Please fix:</p>
          <ul class="mt-1 text-sm text-rose-800 list-disc list-inside space-y-0.5">
            <% @config.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :store_url, class: "block text-sm font-medium text-zinc-700" %>
        <%= form.url_field :store_url, class: "mt-1 block w-full rounded-lg border-zinc-300 shadow-sm focus:border-zinc-900 focus:ring-zinc-900 text-sm", placeholder: "https://yourstore.com" %>
      </div>

      <div>
        <%= form.label :consumer_key, "Consumer key", class: "block text-sm font-medium text-zinc-700" %>
        <%= form.text_field :consumer_key, class: "mt-1 block w-full rounded-lg border-zinc-300 shadow-sm font-mono text-sm focus:border-zinc-900 focus:ring-zinc-900", autocomplete: "off" %>
      </div>

      <div>
        <%= form.label :consumer_secret, "Consumer secret", class: "block text-sm font-medium text-zinc-700" %>
        <%= form.password_field :consumer_secret, value: @config.consumer_secret, class: "mt-1 block w-full rounded-lg border-zinc-300 shadow-sm font-mono text-sm focus:border-zinc-900 focus:ring-zinc-900", autocomplete: "off" %>
      </div>

      <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:justify-between sm:items-center">
        <div class="flex items-center gap-2">
          <button type="button" data-action="woo-test#run" class="bg-white border border-zinc-300 hover:bg-zinc-50 text-zinc-900 text-sm font-medium py-2 px-4 rounded-lg">
            Test connection
          </button>
          <span data-woo-test-target="status" class="text-sm text-zinc-600"></span>
        </div>
        <div class="flex gap-2">
          <%= link_to "Cancel", settings_path, class: "bg-white border border-zinc-300 hover:bg-zinc-50 text-zinc-900 text-sm font-medium py-2 px-4 rounded-lg" %>
          <%= form.submit "Save", class: "bg-zinc-900 hover:bg-zinc-800 text-white text-sm font-semibold py-2 px-4 rounded-lg cursor-pointer" %>
        </div>
      </div>
    <% end %>
  </div>
</div>

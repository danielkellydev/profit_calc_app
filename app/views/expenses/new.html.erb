<div class="max-w-2xl mx-auto">
  <div class="bg-white rounded-xl ring-1 ring-zinc-200 p-4 sm:p-6">
    <h1 class="font-display text-2xl font-bold text-zinc-900 mb-6">New expense</h1>

    <% if @expense_categories.empty? %>
      <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-6">
        <p class="text-amber-900 text-sm">Create at least one expense category first.</p>
        <%= link_to "Create category", new_expense_category_path,
              class: "mt-3 inline-block bg-zinc-900 hover:bg-zinc-800 text-white font-semibold py-1.5 px-3 rounded-lg text-sm" %>
      </div>
    <% else %>
      <%= render 'form', expense: @expense, expense_categories: @expense_categories, submit_label: 'Create expense', cancel_path: expenses_path %>
    <% end %>
  </div>
</div>

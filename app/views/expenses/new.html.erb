<div class="container mx-auto px-4 py-6 sm:py-8">
  <div class="max-w-2xl mx-auto bg-white rounded-lg shadow-md p-4 sm:p-6">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">New expense</h1>

    <% if @expense_categories.empty? %>
      <div class="bg-yellow-50 border border-yellow-200 rounded-md p-4 mb-6">
        <p class="text-yellow-800 text-sm">Create at least one expense category first.</p>
        <%= link_to "Create category", new_expense_category_path,
              class: "mt-2 bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-1 px-3 rounded text-sm inline-block" %>
      </div>
    <% else %>
      <%= render 'form', expense: @expense, expense_categories: @expense_categories, submit_label: 'Create expense', cancel_path: expenses_path %>
    <% end %>
  </div>
</div>

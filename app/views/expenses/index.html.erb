<div class="container mx-auto px-4 py-6 sm:py-8">
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center mb-6 gap-3">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Expenses</h1>
    <div class="flex gap-2">
      <%= link_to "Categories", expense_categories_path,
            class: "bg-gray-500 hover:bg-gray-700 text-white text-sm font-medium py-2 px-4 rounded" %>
      <%= link_to "Dashboard", dashboard_index_path,
            class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2 px-4 rounded" %>
    </div>
  </div>

  <% if @expense_categories.empty? %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-md p-4 mb-6 text-yellow-800 text-sm">
      You need at least one expense category before adding expenses.
      <%= link_to "Create one →", new_expense_category_path, class: "underline font-medium" %>
    </div>
  <% else %>
    <div class="bg-white shadow-md rounded-lg p-4 sm:p-6 mb-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-3">Quick add</h2>
      <%= render 'form', expense: @new_expense, expense_categories: @expense_categories, submit_label: 'Add expense', cancel_path: nil, compact: true %>
    </div>
  <% end %>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
    <%= render 'summary_card', title: 'Weekly',            value: @total_weekly_expenses,    tone: 'green' %>
    <%= render 'summary_card', title: 'Monthly',           value: @total_monthly_expenses,   tone: 'blue' %>
    <%= render 'summary_card', title: 'Annual',            value: @total_annual_expenses,    tone: 'purple' %>
    <%= render 'summary_card', title: 'Claimable Annual',  value: @total_claimable_annual,   tone: 'indigo' %>
  </div>

  <% if @expenses_by_category.any? %>
    <% @expenses_by_category.each do |category, expenses| %>
      <div class="bg-white shadow-md rounded-lg mb-6 overflow-hidden">
        <div class="bg-gray-50 px-4 sm:px-6 py-4 border-b flex justify-between items-center">
          <div>
            <h2 class="text-lg font-semibold text-gray-900">
              <%= category.name %>
              <span class="text-xs text-gray-500 font-normal ml-2">
                default <%= number_with_precision(category.business_use_percentage, strip_insignificant_zeros: true) %>% business use
              </span>
            </h2>
            <% if category.description.present? %>
              <p class="text-sm text-gray-600 mt-1"><%= category.description %></p>
            <% end %>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-50 text-xs text-gray-500 uppercase">
              <tr>
                <th class="px-4 py-2 text-left">Name</th>
                <th class="px-4 py-2 text-right">Amount</th>
                <th class="px-4 py-2 text-left">Frequency</th>
                <th class="px-4 py-2 text-right">Business use</th>
                <th class="px-4 py-2 text-right">Claimable / month</th>
                <th class="px-4 py-2 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100">
              <% expenses.each do |expense| %>
                <tr class="<%= 'opacity-60' unless expense.active %>">
                  <td class="px-4 py-2 font-medium text-gray-900">
                    <%= expense.name %>
                    <% if expense.receipts.attached? %>
                      <span class="ml-1 text-xs text-gray-500" title="<%= expense.receipts.size %> receipt(s) attached">📎<%= expense.receipts.size %></span>
                    <% end %>
                  </td>
                  <td class="px-4 py-2 text-right"><%= number_to_currency(expense.amount) %></td>
                  <td class="px-4 py-2">
                    <%= expense.frequency == 'one_off' ? 'One-off' : expense.frequency.capitalize %>
                    <% if expense.one_off? && expense.start_date %>
                      <span class="block text-xs text-gray-500"><%= expense.start_date.strftime('%-d %b %Y') %></span>
                    <% end %>
                  </td>
                  <td class="px-4 py-2 text-right">
                    <%= number_with_precision(expense.effective_business_use_percentage, strip_insignificant_zeros: true) %>%
                    <% if expense.business_use_percentage_overridden? %>
                      <span class="ml-1 inline-flex items-center px-1.5 py-0.5 rounded-full text-xs bg-yellow-100 text-yellow-800">override</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-2 text-right font-medium text-indigo-700">
                    <%= number_to_currency(expense.claimable_monthly_amount) %>
                  </td>
                  <td class="px-4 py-2 text-right whitespace-nowrap">
                    <%= link_to "Edit", edit_expense_path(expense), class: "text-indigo-600 hover:text-indigo-900 mr-3" %>
                    <%= button_to "Delete", expense_path(expense), method: :delete,
                          form: { data: { turbo_confirm: 'Delete this expense?' } },
                          class: "text-red-600 hover:text-red-900 bg-transparent p-0 border-0 cursor-pointer inline" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="bg-white shadow-md rounded-lg p-8 text-center text-gray-500">
      No expenses yet. Add your first one above.
    </div>
  <% end %>
</div>

<%
  compact ||= false
  submit_label ||= (expense.persisted? ? 'Update expense' : 'Create expense')
%>

<%= form_with model: expense, local: true, class: "space-y-4", data: { controller: "expense-form" } do |form| %>
  <% if expense.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-md p-3">
      <p class="text-red-800 text-sm font-medium">Please fix:</p>
      <ul class="mt-1 text-sm text-red-700 list-disc list-inside">
        <% expense.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 <%= compact ? 'md:grid-cols-3' : 'md:grid-cols-2' %> gap-3">
    <div>
      <%= form.label :name, class: "block text-xs font-medium text-gray-700" %>
      <%= form.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm text-sm", placeholder: "e.g., Power bill" %>
    </div>

    <div>
      <%= form.label :expense_category_id, "Category", class: "block text-xs font-medium text-gray-700" %>
      <%= form.select :expense_category_id,
            options_from_collection_for_select(expense_categories, :id, :name, expense.expense_category_id),
            { prompt: "Select category" },
            { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm text-sm" } %>
    </div>

    <div>
      <%= form.label :amount, class: "block text-xs font-medium text-gray-700" %>
      <%= form.number_field :amount, step: 0.01, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm text-sm", placeholder: "0.00" %>
    </div>

    <div>
      <%= form.label :frequency, class: "block text-xs font-medium text-gray-700" %>
      <%= form.select :frequency,
            options_for_select([
              ['Weekly', 'weekly'],
              ['Monthly', 'monthly'],
              ['Annually', 'annually'],
              ['One-off purchase', 'one_off']
            ], expense.frequency),
            {},
            { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm text-sm",
              data: { expense_form_target: "frequency", action: "change->expense-form#toggle" } } %>
    </div>

    <div>
      <label for="<%= form.field_id(:start_date) %>" class="block text-xs font-medium text-gray-700">
        <span data-expense-form-target="oneOffLabel" class="<%= 'hidden' unless expense.one_off? %>">Purchase date</span>
        <span data-expense-form-target="recurringStartLabel" class="<%= 'hidden' if expense.one_off? %>">Start date (optional)</span>
      </label>
      <%= form.date_field :start_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm text-sm" %>
    </div>

    <div data-expense-form-target="endDate" class="<%= 'hidden' if expense.one_off? || compact %>">
      <%= form.label :end_date, "End date (optional)", class: "block text-xs font-medium text-gray-700" %>
      <%= form.date_field :end_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm text-sm" %>
    </div>

    <div>
      <%= form.label :business_use_percentage, "Business use % (override)", class: "block text-xs font-medium text-gray-700" %>
      <%= form.number_field :business_use_percentage, min: 0, max: 100, step: 0.01,
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm text-sm",
            placeholder: "Use category default" %>
    </div>

    <% unless compact %>
      <div class="flex items-center mt-6">
        <%= form.check_box :active, class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" %>
        <%= form.label :active, "Active", class: "ml-2 text-sm text-gray-900" %>
      </div>
    <% end %>
  </div>

  <div class="<%= 'md:col-span-2' unless compact %>">
    <%= form.label :receipts, "Receipts (PDF or image, up to 10 MB each)", class: "block text-xs font-medium text-gray-700" %>
    <%= form.file_field :receipts, multiple: true, accept: "application/pdf,image/*",
          class: "mt-1 block w-full text-sm text-gray-700 file:mr-3 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>

    <% if expense.persisted? && expense.receipts.attached? %>
      <ul class="mt-3 space-y-1">
        <% expense.receipts.each do |receipt| %>
          <li class="flex items-center justify-between bg-gray-50 rounded px-3 py-2 text-sm">
            <%= link_to receipt.filename.to_s, rails_blob_path(receipt, disposition: "attachment"), class: "text-blue-600 hover:text-blue-900" %>
            <span class="text-xs text-gray-500"><%= number_to_human_size(receipt.byte_size) %></span>
            <%= button_to "Remove", expense_receipt_path(expense, receipt.id), method: :delete,
                  form: { data: { turbo_confirm: 'Remove this receipt?' } },
                  class: "text-red-600 hover:text-red-900 text-xs bg-transparent p-0 border-0 cursor-pointer" %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <div class="flex justify-end gap-2">
    <% if cancel_path %>
      <%= link_to "Cancel", cancel_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-800 text-sm font-medium py-2 px-4 rounded" %>
    <% end %>
    <%= form.submit submit_label, class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2 px-4 rounded" %>
  </div>
<% end %>

<div class="min-h-[80vh] flex items-center justify-center px-4 py-10 sm:py-16">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <h1 class="font-display text-2xl sm:text-3xl font-bold text-zinc-900">Resend unlock instructions</h1>
    </div>

    <div class="bg-white rounded-xl shadow-sm ring-1 ring-zinc-200 p-6 sm:p-8">
      <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <%= f.label :email, class: "block text-sm font-medium text-zinc-700" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "mt-1 block w-full rounded-lg border-zinc-300 shadow-sm focus:border-zinc-900 focus:ring-zinc-900 text-sm" %>
        </div>

        <%= f.submit "Resend instructions",
              class: "w-full bg-zinc-900 hover:bg-zinc-800 text-white text-sm font-semibold py-2.5 px-4 rounded-lg transition cursor-pointer" %>
      <% end %>

      <div class="mt-6 pt-6 border-t border-zinc-100">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>

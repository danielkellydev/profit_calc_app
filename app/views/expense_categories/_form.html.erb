<%= form_with model: expense_category, local: true, class: "space-y-4" do |form| %>
  <% if expense_category.errors.any? %>
    <div class="bg-rose-50 border border-rose-200 rounded-lg p-3">
      <p class="text-rose-900 text-sm font-semibold">Please fix:</p>
      <ul class="mt-1 text-sm text-rose-800 list-disc list-inside space-y-0.5">
        <% expense_category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-zinc-700" %>
    <%= form.text_field :name, class: "mt-1 block w-full rounded-lg border-zinc-300 shadow-sm focus:border-zinc-900 focus:ring-zinc-900 text-sm" %>
  </div>

  <div>
    <%= form.label :description, "Description (optional)", class: "block text-sm font-medium text-zinc-700" %>
    <%= form.text_area :description, rows: 2, class: "mt-1 block w-full rounded-lg border-zinc-300 shadow-sm focus:border-zinc-900 focus:ring-zinc-900 text-sm" %>
  </div>

  <div data-controller="floor-area">
    <%= form.label :business_use_percentage, "Default business use %", class: "block text-sm font-medium text-zinc-700" %>
    <%= form.number_field :business_use_percentage, min: 0, max: 100, step: 0.01,
          class: "mt-1 block w-full rounded-lg border-zinc-300 shadow-sm tabular-nums focus:border-zinc-900 focus:ring-zinc-900 text-sm",
          data: { floor_area_target: "result" } %>
    <p class="mt-1 text-xs text-zinc-500">
      Applied to expenses in this category. Individual expenses can override.
    </p>

    <details class="mt-3 text-xs text-zinc-600 bg-zinc-50 rounded-lg p-3">
      <summary class="cursor-pointer text-zinc-900 font-medium">Floor-area suggestion (room count)</summary>
      <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2">
        <label class="flex flex-col gap-1">
          <span class="text-zinc-700">Rooms used for business</span>
          <input type="number" min="0" step="1" value="2" data-floor-area-target="used" data-action="input->floor-area#calc"
                 class="rounded-lg border-zinc-300 text-sm tabular-nums focus:border-zinc-900 focus:ring-zinc-900" />
        </label>
        <label class="flex flex-col gap-1">
          <span class="text-zinc-700">Total rooms in house</span>
          <input type="number" min="1" step="1" value="3" data-floor-area-target="total" data-action="input->floor-area#calc"
                 class="rounded-lg border-zinc-300 text-sm tabular-nums focus:border-zinc-900 focus:ring-zinc-900" />
        </label>
      </div>
      <p class="mt-3">
        Suggested: <span data-floor-area-target="suggestion" class="tabular-nums font-medium text-zinc-900">—</span>
        <button type="button" data-action="floor-area#apply" class="ml-2 text-zinc-900 underline underline-offset-2">apply</button>
      </p>
      <p class="mt-2 text-zinc-500">
        Tip: 1 bedroom + 1 shed in a 3-bed house is roughly 25–40% by room count.
        ATO floor-area method may give a different number — confirm with your accountant.
      </p>
    </details>
  </div>

  <div class="flex flex-col sm:flex-row sm:justify-end gap-2 pt-2">
    <%= link_to "Cancel", expense_categories_path, class: "bg-white border border-zinc-300 hover:bg-zinc-50 text-zinc-900 text-sm font-medium py-2 px-4 rounded-lg text-center" %>
    <%= form.submit (expense_category.persisted? ? "Update category" : "Create category"),
          class: "bg-zinc-900 hover:bg-zinc-800 text-white text-sm font-semibold py-2 px-4 rounded-lg cursor-pointer" %>
  </div>
<% end %>

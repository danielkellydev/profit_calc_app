<%= form_with model: expense_category, local: true, class: "space-y-4" do |form| %>
  <% if expense_category.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-md p-3">
      <p class="text-red-800 text-sm font-medium">Please fix:</p>
      <ul class="mt-1 text-sm text-red-700 list-disc list-inside">
        <% expense_category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
  </div>

  <div>
    <%= form.label :description, "Description (optional)", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_area :description, rows: 2, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
  </div>

  <div data-controller="floor-area">
    <%= form.label :business_use_percentage, "Default business use %", class: "block text-sm font-medium text-gray-700" %>
    <%= form.number_field :business_use_percentage, min: 0, max: 100, step: 0.01,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm",
          data: { floor_area_target: "result" } %>
    <p class="mt-1 text-xs text-gray-500">
      Applied to expenses in this category. Individual expenses can override.
    </p>

    <details class="mt-2 text-xs text-gray-600">
      <summary class="cursor-pointer text-blue-600">Floor-area suggestion (room count)</summary>
      <div class="mt-2 grid grid-cols-2 gap-2">
        <label class="flex flex-col">
          <span>Rooms used for business</span>
          <input type="number" min="0" step="1" value="2" data-floor-area-target="used" data-action="input->floor-area#calc" class="rounded-md border-gray-300 text-sm" />
        </label>
        <label class="flex flex-col">
          <span>Total rooms in house</span>
          <input type="number" min="1" step="1" value="3" data-floor-area-target="total" data-action="input->floor-area#calc" class="rounded-md border-gray-300 text-sm" />
        </label>
      </div>
      <p class="mt-1">
        Suggested: <span data-floor-area-target="suggestion">—</span>
        <button type="button" data-action="floor-area#apply" class="ml-2 text-blue-600 underline">apply</button>
      </p>
      <p class="mt-1 text-gray-500">
        Tip: 1 bedroom + 1 shed in a 3-bed house is roughly 25–40% by room count.
        ATO floor-area method may give a different number — confirm with your accountant.
      </p>
    </details>
  </div>

  <div class="flex justify-end gap-2">
    <%= link_to "Cancel", expense_categories_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-800 text-sm font-medium py-2 px-4 rounded" %>
    <%= form.submit (expense_category.persisted? ? "Update category" : "Create category"),
          class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2 px-4 rounded" %>
  </div>
<% end %>
